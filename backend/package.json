{
    "name": "@footypal/backend",
    "version": "1.0.0-dev",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "test": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testMatch \"**/tests/**/*.test.mjs\""
    },
    "dependencies": {
        "express": "^5.1.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.3",
        "@types/node": "^22.15.30",
        "jest": "^30.5.2",
        "nodemon": "^3.1.10",
        "supertest": "^7.3.1",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    }
}
